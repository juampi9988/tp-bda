        {
          "name": "4.2 RN-02: Bloque Ocupado en Google Calendar (Walk-in 13:30 hs) -> 409 Conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('RN-02: Rechaza turno cuando Google Calendar informa compromiso externo (409 Conflict)', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_cliente}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"peluqueroId\": 1,\n  \"servicioId\": 1,\n  \"fechaHoraInicio\": \"2027-05-12T13:30:00\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/turnos",
              "host": ["{{gateway_url}}"],
              "path": ["api", "turnos"]
            }
          }
        },
        {
          "name": "4.3 RN-03: Canje con Saldo Insuficiente (Premio #3 de 500 pts) -> 422 Unprocessable Entity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('RN-03: Rechaza reserva cuando el saldo de puntos es insuficiente (422 Unprocessable Entity)', function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_cliente}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"peluqueroId\": 1,\n  \"servicioId\": 1,\n  \"fechaHoraInicio\": \"2027-05-14T11:00:00\",\n  \"premioId\": 3\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/turnos",
              "host": ["{{gateway_url}}"],
              "path": ["api", "turnos"]
            }
          }
        },
        {
          "name": "4.4 RN-04: Intentar Completar un Turno Ya Completado -> 409 Conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('RN-04: Impide completar dos veces el mismo turno para evitar doble acreditación (409 Conflict)', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/turnos/{{turno_id_1}}/completar",
              "host": ["{{gateway_url}}"],
              "path": ["api", "turnos", "{{turno_id_1}}", "completar"]
            }
          }
        }
      ]
    }
